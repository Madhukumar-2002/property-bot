# ============================================
# Property Solutions Bot - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ============================================
# WhatsApp Configuration (Required)
# ============================================
# Get these from Meta Developer Dashboard: https://developers.facebook.com/apps
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_ID=your_phone_number_id_here
VERIFY_TOKEN=your_webhook_verify_token_here

# ============================================
# MongoDB Configuration (Required)
# ============================================
# Get this from MongoDB Atlas: https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=your_mongodb_connection_string_here

# ============================================
# Vapi.ai Configuration (Required for AI Agent)
# ============================================
# Get these from Vapi Dashboard: https://dashboard.vapi.ai
VAPI_API_KEY=your_vapi_api_key_here
VAPI_ASSISTANT_ID=4a2ca879-e6c9-4379-a6b9-98eb38f20f27
VAPI_PHONE_NUMBER_ID=21f3119a-899b-4685-9e02-f785fdae2f99

# ============================================
# Exotel Configuration (Optional - for human agent calls)
# ============================================
# Get these from Exotel Dashboard: https://my.exotel.com
EXOTEL_SID=propertysolutionsbot1
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_NUMBER=08047280067
AGENT_NUMBER=9876543210

# ============================================
# Server Configuration (Optional)
# ============================================
PORT=8080
NODE_ENV=production
